; Controlled F2->F5 reconstruction + M4-M6 visual upgrade.
config_version=5

[application]
config/name="Ilyrion — Vertical Slice Reconstructed"
run/main_scene="res://rebuild/main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

[display/window]
size/viewport_width=640
size/viewport_height=360
size/window_width_override=1280
size/window_height_override=720
size/resizable=true
stretch/mode="canvas_items"
stretch/aspect="expand"
handheld/orientation=0

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventKey,"physical_keycode":32)]}
attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74),Object(InputEventMouseButton,"button_index":1)]}
dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":75)]}
potion={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":72)]}
save_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
load_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194326)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
